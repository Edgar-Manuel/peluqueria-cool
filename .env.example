# =====================================================
# PELUQUERÍA COOL - ENVIRONMENT VARIABLES
# =====================================================
# Copia este archivo a .env y rellena los valores reales
# NUNCA subas el archivo .env a Git
# =====================================================

# =====================================================
# 🔧 CONFIGURACIÓN DE OPCIONES DE RESERVAS
# =====================================================
# Elige qué sistema de reservas usar:
# - emailjs     → Opción 1: Emails simples
# - calendly    → Opción 2: Calendario externo
# - whatsapp    → Opción 3: WhatsApp directo
# - supabase    → Opción 5: Panel Admin completo (recomendado)
# -----------------------------------------------------
RESERVATION_SYSTEM=supabase

# =====================================================
# 🟢 OPCIÓN 1: EMAILJS (Emails simples)
# https://www.emailjs.com/docs/sdk/installation/
# =====================================================
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx
EMAILJS_TO_EMAIL=tucorreo@email.com

# =====================================================
# 🟡 OPCIÓN 2: CALENDLY / SIMPLYBOOK.ME
# =====================================================
# Calendly: https://calendly.com/integrations
CALENDLY_URL=https://calendly.com/tu-usuario/reserva
CALENDLY_EMBED=true

# SimplyBook.me: https://simplybook.me/
SIMPLYBOOK_COMPANY=tu-empresa
SIMPLYBOOK_WIDGET_URL=https://tu-empresa.simplybook.me/v2/

# =====================================================
# 🟠 OPCIÓN 3: WHATSAPP BUSINESS
# =====================================================
# Número en formato internacional (sin + ni espacios)
WHATSAPP_PHONE=34600000000
WHATSAPP_DEFAULT_MESSAGE=Hola! Me gustaría reservar una cita.

# =====================================================
# 🟣 OPCIÓN 5: SUPABASE (Panel Admin Completo)
# https://supabase.com/dashboard
# =====================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =====================================================
# 💳 STRIPE (Pagos de productos)
# https://dashboard.stripe.com/apikeys
# =====================================================
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# =====================================================
# 📧 RESEND (Emails transaccionales)
# https://resend.com/api-keys
# =====================================================
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=reservas@peluqueriacool.es

# =====================================================
# 📱 TWILIO (SMS/WhatsApp API - Para notificaciones)
# https://console.twilio.com
# =====================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=+34xxxxxxxxx

# =====================================================
# 📊 GOOGLE SERVICES
# =====================================================
# Analytics: https://analytics.google.com
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Maps: https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxxxxx

# Calendar (para sincronización): https://console.cloud.google.com
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_CALENDAR_API_KEY=AIzaSyxxxxxxxxxxxxx

# =====================================================
# ⚙️ APP CONFIG
# =====================================================
APP_URL=https://peluqueriacool.es
APP_NAME=Peluquería Cool
ADMIN_EMAIL=admin@peluqueriacool.es
SALON_PHONE=+34942589703
SALON_ADDRESS=C/ Ejemplo 123, Arce, Cantabria

# =====================================================
# 🔒 SEGURIDAD
# =====================================================
# Secreto para firmar tokens (genera uno aleatorio)
JWT_SECRET=your-random-secret-key-here-min-32-chars
# Máximo intentos de login antes de bloquear
MAX_LOGIN_ATTEMPTS=5
# Minutos de bloqueo tras exceder intentos
# Espacio para el Webhook saliente (Chatfuel/Make)
WEBHOOK_URL=https://hook.make.com/your-scenario-id

